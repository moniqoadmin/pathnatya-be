# Application
PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed by CORS (scheme + host + port).
# Do not use *. Leave empty to allow only non-browser clients (no Origin header),
# e.g. Electron main process, curl. Example for local Swagger + a Vite UI:
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=

# Database (PostgreSQL on Railway)
# When running locally / outside Railway, use the PUBLIC connection string.
# Get the TCP proxy host + port from Railway: Postgres service -> Variables ->
# RAILWAY_TCP_PROXY_DOMAIN and RAILWAY_TCP_PROXY_PORT (or the "Connect" tab).
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@RAILWAY_TCP_PROXY_DOMAIN:RAILWAY_TCP_PROXY_PORT/railway

DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
SWAGGER_ENABLED=false
LOGIN_HASH_CONCURRENCY=4
LOGIN_HASH_QUEUE_LIMIT=500
LOGIN_RETRY_AFTER_SECONDS=5
LOGIN_PHONE_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=100
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
# Maximum imports processed simultaneously in this process.
IMPORT_QUEUE_CONCURRENCY=1
IMPORT_MAX_FILE_SIZE_MB=20
IMPORT_JOB_RETENTION_DAYS=7

# Set to true to let TypeORM auto-create tables from entities (dev only).
DB_SYNCHRONIZE=false
# Set to true to log SQL queries.
DB_LOGGING=false
# Set to true to require SSL (Railway public endpoint typically needs this).
DB_SSL=true

# Secret used to encrypt/decrypt JWE auth tokens (any string; hashed to a 256-bit key).
JWE_SECRET=change-me-in-production

# Shared secret the Electron app sends in the X-App-Key header on every request.
ELECTRON_APP_KEY=change-me-in-production

# Used to encrypt/decrypt JSON request & response bodies (SHA-256 → A256GCM JWE).
ELECTRON_APP_1=x0m2-7u04b-5e1g-h7z1

# When true (default), JSON bodies must be { "payload": "<compact-jwe>" } and
# JSON responses are wrapped the same way. Set false for local Swagger/curl testing.
PAYLOAD_ENCRYPTION=true

# Login success keys returned by GET /api/accounts/login-token.
LOGIN_SUCCESS_KEY_1=change-me-login-key-1
LOGIN_SUCCESS_KEY_2=change-me-login-key-2
LOGIN_SUCCESS_KEY_3=change-me-login-key-3
LOGIN_SUCCESS_KEY_4=change-me-login-key-4
LOGIN_SUCCESS_KEY_5=change-me-login-key-5

# Rate limiting (per IP). Exceeding the limit returns HTTP 429.
# Global default: THROTTLE_LIMIT requests per THROTTLE_TTL_MS.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Auth endpoints (login, set-password, check-phone, create) use a fixed 10/min cap.
# Optional. When set, requests with header X-Load-Test-Key matching this value
# skip all rate limits (use only for load testing; leave unset in production).
# LOAD_TEST_KEY=
